{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(uv run python -m pytest*)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "Bash(uv run python -m pytest*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "PowerShell(uv run python -m ruff check .)",
      "PowerShell(uv run python -m ruff format .)",
      "PowerShell(uv run python -m ruff format --check .)",
      "Bash(uv run python -m ruff check .)",
      "Bash(uv run python -m ruff format .)",
      "Bash(uv run python -m ruff format --check .)"
    ],
    "ask": [
      "PowerShell(git push *)",
      "PowerShell(git tag *)",
      "PowerShell(git merge *)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(git merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Edit(./data/repos/**)"
    ]
  }
}